#include <stdio.h>

int main() {
    float salary, bonus, total;

    printf("Enter basic salary: ");
    scanf("%f", &salary);

    if (salary >= 50000)
        bonus = (salary * 20) / 100;
    else if (salary >= 30000)
        bonus = (salary * 10) / 100;
    else
        bonus = (salary * 5) / 100;

    total = salary + bonus;

    printf("Bonus: %.2f\n", bonus);
    printf("Total Salary: %.2f", total);

    return 0;
}
