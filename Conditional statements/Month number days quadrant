#include <stdio.h>

int main() {
    int month;

    printf("Enter month number (1-12): ");
    scanf("%d", &month);

    switch(month) {
        case 1: case 3: case 5: case 7: case 8: case 10: case 12:
            printf("Days: 31\n");
            break;
        case 4: case 6: case 9: case 11:
            printf("Days: 30\n");
            break;
        case 2:
            printf("Days: 28 or 29\n");
            break;
        default:
            printf("Invalid month\n");
    }

    if (month >=1 && month <=3)
        printf("Quadrant: Q1");
    else if (month <=6)
        printf("Quadrant: Q2");
    else if (month <=9)
        printf("Quadrant: Q3");
    else if (month <=12)
        printf("Quadrant: Q4");

    return 0;
}
