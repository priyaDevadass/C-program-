#include <stdio.h>

int main() {
    float salary, bonus;
    char gender;

    printf("Enter salary: ");
    scanf("%f", &salary);

    printf("Enter gender (M/F): ");
    scanf(" %c", &gender);

    if (gender == 'F' || gender == 'f')
        bonus = 0.10 * salary;
    else
        bonus = 0.05 * salary;

    printf("Final Salary = %.2f\n", salary + bonus);

    return 0;
}
