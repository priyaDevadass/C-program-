#include <stdio.h>

int main() {
    int num, divisor;

    printf("Enter number: ");
    scanf("%d", &num);

    printf("Enter divisor: ");
    scanf("%d", &divisor);

    if (divisor == 0)
        printf("Error! Division by zero not allowed.\n");
    else if (num % divisor == 0)
        printf("Divisible\n");
    else
        printf("Not Divisible\n");

    return 0;
}
