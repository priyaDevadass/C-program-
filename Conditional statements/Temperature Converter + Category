#include <stdio.h>

int main() {
    float c, f;

    printf("Enter temperature in Celsius: ");
    scanf("%f", &c);

    f = (c * 9 / 5) + 32;

    printf("Fahrenheit: %.2f\n", f);

    if (c < 10)
        printf("Cold");
    else if (c <= 30)
        printf("Normal");
    else
        printf("Hot");

    return 0;
}
