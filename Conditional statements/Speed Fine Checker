#include <stdio.h>

int main() {
    float distance, time, speed;

    printf("Enter distance: ");
    scanf("%f", &distance);

    printf("Enter time: ");
    scanf("%f", &time);

    speed = distance / time;

    printf("Speed: %.2f\n", speed);

    if (speed > 100)
        printf("Fine: Rs.1000");
    else if (speed > 80)
        printf("Fine: Rs.500");
    else
        printf("No Fine");

    return 0;
}
