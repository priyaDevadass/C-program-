#include <stdio.h>

int main() {
    float h;
    printf("Enter height (cm): ");
    scanf("%f", &h);

    if (h < 150)
        printf("Short\n");
    else if (h <= 165)
        printf("Average Height\n");
    else if (h <= 180)
        printf("Tall\n");
    else
        printf("Very Tall\n");

    return 0;
}
